# Telegram approval hook credentials
# Copy this file to .env.telegram (per-project) or ~/.claude/telegram.env (global)
# Per-project takes precedence over global when both exist.
#
# Setup:
#   1. Message @BotFather on Telegram → /newbot → copy the token below
#   2. Message @userinfobot on Telegram → copy your numeric ID as TELEGRAM_CHAT_ID
#   3. Start a conversation with your bot (send it any message) so it can message you

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=987654321

# Optional: comma-separated list of tool names to intercept (default: Bash)
# TELEGRAM_INTERCEPT_TOOLS=Bash
